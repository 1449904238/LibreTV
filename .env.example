# 必填：访问密码（不设置时站点会提示管理员配置后再可用）
PASSWORD=change-me

# 可选：会话/代理签名密钥；不设置时从 PASSWORD 派生
# 多实例部署建议显式设置：openssl rand -hex 32
# PROXY_SECRET=

# 可选：多账号（不同密码看到不同的点播源/直播源）
# PASSWORD 登录的是默认账号，源取全局 DEFAULT_SOURCES / DEFAULT_LIVE_SOURCES（独立配置）；
# ACCOUNTS 中每个密码自成一个账号，没配的类型返回空（不回退全局）；
# name 是前端显示的当前线路名，请取中性名称；未登录时返回空源，需登录后获取。
# 不配 ACCOUNTS 时行为与原来完全一致。
# 真实密码只写在服务器的 .env 里，不要写在这里。
# ACCOUNTS=[{"name":"线路一","password":"pwd-1","sources":[{"name":"量子资源","url":"https://cj.lziapi.com/api.php/provide/vod"}],"liveSources":[]},{"name":"线路二","password":"pwd-2","sources":[],"liveSources":[]}]
# 可选：默认账号的显示名（默认“默认线路”）
# PASSWORD_NAME=

# 可选：Cookie Secure 策略覆盖（true=强制开启 / false=强制关闭；不设置时按请求协议自动推导，HTTP 部署无需配置）
# COOKIE_SECURE=

# 可选：代理请求上游的超时与重试
REQUEST_TIMEOUT=8000
MAX_RETRIES=1

# 可选：影视榜单推荐源（60s API）实例地址，默认官方公共实例 https://60s.viki.moe。
# 官方实例有限流（本项目每小时仅请求 6 次榜单，通常够用）；高频使用可自部署：docker run -d -p 4399:4399 vikiboss/60s:latest
# 60S_API_BASE=https://60s.viki.moe

# 可选：调试
DEBUG=false

# 可选：固定使用某个发布镜像版本（默认不设置 = ghcr.io/librespark/libretv:latest，
# 首次部署先 docker compose pull 拉取；本地开发可用 docker compose up -d --build 构建）
# LIBRETV_IMAGE=ghcr.io/librespark/libretv:2.0.1

# 可选：预置采集站（JSON 数组），用户端自动出现且默认勾选
# 已与当前 .env 的 DEFAULT_SOURCES 结构同步，生产启用时去掉行首 # 即可
# DEFAULT_SOURCES=[{"name":"量子资源","url":"https://cj.lziapi.com/api.php/provide/vod"},{"name":"如意资源","url":"https://cj.rycjapi.com/api.php/provide/vod"},{"name":"非凡资源","url":"http://cj.ffzyapi.com/api.php/provide/vod"},{"name":"红牛资源","url":"https://www.hongniuzy2.com/api.php/provide/vod"},{"name":"360资源","url":"https://360zy.com/api.php/provide/vod"},{"name":"最大资源","url":"https://api.zuidapi.com/api.php/provide/vod"},{"name":"暴风资源","url":"https://bfzyapi.com/api.php/provide/vod"},{"name":"无尽资源","url":"https://api.wujinapi.me/api.php/provide/vod"},{"name":"金鹰资源","url":"https://jyzyapi.com/api.php/provide/vod"},{"name":"爱奇艺资源","url":"https://iqiyizyapi.com/api.php/provide/vod"},{"name":"爱坤资源","url":"https://ikunzyapi.com/api.php/provide/vod"},{"name":"魔都资源","url":"https://www.mdzyapi.com/api.php/provide/vod"},{"name":"猫眼资源","url":"https://api.maoyanapi.top/api.php/provide/vod"}]

# 可选：预置直播源（M3U 订阅，JSON 数组），epg 为可选节目单地址
# DEFAULT_LIVE_SOURCES=[{"name":"示例直播源","url":"https://example.com/list.m3u","epg":"https://example.com/epg.xml.gz"}]

# 可选：预置数据源订阅（SourceList JSON 链接，一次下发点播源 + 直播源）
# DEFAULT_SUBSCRIPTIONS=["https://example.com/sources.json"]

# 可选：完整多账号示例结构（当前 .env 中的 ACCOUNTS 即此结构，密码已脱敏）
# 正式环境的真实 ACCOUNTS 请直接写在服务器的 .env 里（去掉行首 # 并填入真实 password），不要提交到 Git
# ACCOUNTS_FULL_EXAMPLE=[{"name":"线路一","password":"pwd-1","sources":[{"name":"量子资源","url":"https://cj.lziapi.com/api.php/provide/vod"},{"name":"森林资源","url":"https://slapibf.com/api.php/provide/vod"},{"name":"鲨鱼资源","url":"https://shayuapi.com/api.php/provide/vod"}],"liveSources":[]}]